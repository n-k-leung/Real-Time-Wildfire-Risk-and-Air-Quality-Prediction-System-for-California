# -----------------------------
# Airflow Variables used by DAGs
# -----------------------------
AIRFLOW_VAR_LATITUDE_CUPERTINO=37.3229978
AIRFLOW_VAR_LONGITUDE_CUPERTINO=-122.0321823

AIRFLOW_VAR_LATITUDE_SANJOSE=37.3382082
AIRFLOW_VAR_LONGITUDE_SANJOSE=-121.8863286

AIRFLOW_VAR_LATITUDE_SANFRANCISCO=37.7749295
AIRFLOW_VAR_LONGITUDE_SANFRANCISCO=-122.4194155

# -----------------------------
# Airflow Connection for SnowflakeHook("snowflake_con")
# -----------------------------
# Format:
# AIRFLOW_CONN_<CONN_ID>=snowflake://<user>:<password>@<account>/<database>/<schema>?warehouse=<warehouse>&role=<role>
AIRFLOW_CONN_SNOWFLAKE_CON=snowflake://YOUR_USER:YOUR_PASSWORD@YOUR_ACCOUNT/YOUR_DATABASE/YOUR_SCHEMA?warehouse=YOUR_WAREHOUSE&role=YOUR_ROLE

# -----------------------------
# Fire dataset object names (for SQL scripts / future DAGs)
# -----------------------------
FIRE_DATABASE=USER_DB_CHEETAH
FIRE_RAW_SCHEMA=raw
FIRE_STAGING_SCHEMA=staging

# -----------------------------
# Optional API key (recommended)
# -----------------------------
# Current DAGs use a hardcoded AIRNOW_API_KEY constant. If you switch those to
# os.getenv("AIRNOW_API_KEY"), this value will be picked up from env.
AIRNOW_API_KEY=YOUR_AIRNOW_API_KEY
